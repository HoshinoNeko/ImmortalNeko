# Only the optional Xray transport is configured here. WireGuard and L2TPv3 use network UCI.
# Fill addresses, identifiers and certificate/key paths locally after flashing.
config transport 'main'
	option enabled '0'
	option role 'client'
	option security 'tls'
	option proxy_port '51821'
	option target_address '127.0.0.1'
	option target_port '51820'
	option server ''
	option server_port '443'
	option server_name ''
	option uuid ''
	option flow ''
	option egress_device ''
	option listen_address ''
	option certificate_file ''
	option certificate_key_file ''
	option ca_certificate_file ''
	option reality_public_key ''
	option reality_private_key_file ''
	option reality_short_id ''
	option reality_target ''
