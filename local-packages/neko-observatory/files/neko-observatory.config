config observatory 'main'
	option enabled '1'
	option auto_discover '1'
	option interval '5'
	option history_points '360'
	option ac_enabled '1'
	option ac_url 'http://172.16.10.89'
	option ac_password_file '/etc/neko-observatory/ac-password'
	option ac_interval '30'
	option ac_stale_after '120'
	option ap_stale_after '180'

# Optional explicit entries: logical netifd interfaces, never physical ports.
# config vlan
#     option interface 'guest'
#     option label 'Guest'
