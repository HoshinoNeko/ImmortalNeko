#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98

start_service() {
    [ "$(uci -q get neko-observatory.main.enabled)" = 1 ] || return 0
    [ ! -L /var/run/neko-observatory ] || return 1
    umask 077
    mkdir -p /var/run/neko-observatory || return 1
    chmod 700 /var/run/neko-observatory || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/neko-observatory/collector.py
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    [ ! -L /var/run/neko-observatory ] || return 1
    rm -f /var/run/neko-observatory/snapshot.json
}

service_triggers() {
    procd_add_reload_trigger neko-observatory network firewall
}
