#!/bin/sh /etc/rc.common
START=95
STOP=05
USE_PROCD=1

start_service() {
    [ "$(uci -q get firmware-ha.main.enabled)" = 1 ] || return 0
    local HA_LIB=/usr/libexec/firmware-ha
    . "$HA_LIB/lib.sh"
    load_settings || return 1
    # Validate all preconditions before stopping or disabling existing services.
    [ "$mode" != cold-pppoe ] || {
        [ "$(uci -q get network.$wan.proto)" = pppoe ] || { fail 'cold mode requires configured PPPoE'; return 1; }
        [ "$(uci -q get network.$wan.auto)" = 0 ] || { fail 'set WAN auto=0 before enabling cold HA'; return 1; }
    }
    mkdir -p "$HA_RUN"
    chmod 700 "$HA_RUN"
    /usr/libexec/firmware-ha/render.sh > "$HA_RUN/keepalived.conf.new" || return 1
    /usr/sbin/keepalived --config-test -f "$HA_RUN/keepalived.conf.new" || return 1
    mv "$HA_RUN/keepalived.conf.new" "$HA_RUN/keepalived.conf"
    # Never run both the stock UCI daemon and our private config daemon.
    /etc/init.d/keepalived stop || return 1
    /etc/init.d/keepalived disable || return 1
    for service in $services; do "$HA_INIT/$service" disable || return 1; done
    /usr/libexec/firmware-ha/notify.sh BACKUP || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/keepalived -n -f "$HA_RUN/keepalived.conf"
    procd_set_param file /etc/config/firmware-ha
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
stop_service() {
    [ "$(uci -q get firmware-ha.main.enabled)" = 1 ] || return 0
    /usr/libexec/firmware-ha/notify.sh STOP
}
service_triggers() {
    procd_add_reload_trigger firmware-ha
}
