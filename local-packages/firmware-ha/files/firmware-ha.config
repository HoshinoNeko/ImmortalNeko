# Fill topology locally AFTER flashing. No credentials belong in this file.
config ha 'main'
	option enabled '0'
	option initialized '0'
	option role 'primary'
	option mode 'cold-pppoe'
	option lan_device ''
	option election_device ''
	option election_source ''
	option election_peer ''
	option vip ''
	option wan_interface 'wan'
	option wan_l2_device ''
	option vrid '51'
	option preempt_delay '30'
	option acquire_grace '90'
	option retry_base '300'
	option retry_max '3600'
	option probe_quorum '1'
	# Add at least two user-chosen IPv4 probe addresses.
	# list probe '...'
	list service 'dnsmasq'
	list service 'odhcpd'
	list service 'openvpn'
	list service 'ddns-go'
	list service 'zerotier'
	list service 'frpc'

	# Optional locally configured WireGuard interfaces to transfer with the role.
	# list managed_interface 'wg0'

	# Additional IPv4 gateways; empty until the actual VLAN topology is confirmed.
	# Syntax: list extra_vip 'address/prefix@linux-device'
