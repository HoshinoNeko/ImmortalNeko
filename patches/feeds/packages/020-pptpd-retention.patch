--- /dev/null
+++ b/net/pptpd/files/chap-filter.awk
@@ -0,0 +1,27 @@
+# Parse only the first two PPP words; retain every non-PPTP entry verbatim.
+function server(line,    i,c,word,count,quote,escaped,started) {
+	word=""; count=0; quote=""; escaped=0; started=0
+	for (i=1; i<=length(line); i++) {
+		c=substr(line,i,1)
+		if (escaped) { word=word c; escaped=0; started=1; continue }
+		if (c=="\\") { escaped=1; started=1; continue }
+		if (quote!="") {
+			if (c==quote) quote=""
+			else word=word c
+			continue
+		}
+		if (c=="\"" || c=="\047") { quote=c; started=1; continue }
+		if (c=="#") break
+		if (c ~ /[ \t\r]/) {
+			if (started) {
+				count++
+				if (count==2) return word
+				word=""; started=0
+			}
+		} else { word=word c; started=1 }
+	}
+	if (quote!="" || escaped) return ""
+	if (started && count==1) return word
+	return ""
+}
+server($0)!="pptp-server" { print }
