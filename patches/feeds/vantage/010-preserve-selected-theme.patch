+#!/bin/sh
+# Register Vantage while preserving the administrator's selected theme.
+uci -q set luci.themes.Vantage=/luci-static/vantage || exit 1
+if [ -z "$(uci -q get luci.main.mediaurlbase)" ]; then
+	uci -q set luci.main.mediaurlbase=/luci-static/vantage || exit 1
+fi
+uci -q commit luci
+exit 0
