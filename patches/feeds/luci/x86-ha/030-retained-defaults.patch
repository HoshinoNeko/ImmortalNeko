+set -eu
+umask 077
+# The GUI consumes and removes this private export after generation.
+rm -f /tmp/my.ovpn
+pki=/etc/openvpn/pki
+ddns=$(uci -q get openvpn.myvpn.ddns)
+port=$(uci -q get openvpn.myvpn.port)
+proto=$(uci -q get openvpn.myvpn.proto)
+case "$ddns" in ''|*[!a-zA-Z0-9._:-]*) exit 1;; esac
+case "$port" in ''|*[!0-9]*) exit 1;; esac
+[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || exit 1
+case "$proto" in
+    tcp|tcp-server) proto=tcp-client;;
+    tcp4|tcp4-server) proto=tcp4-client;;
+    tcp6|tcp6-server) proto=tcp6-client;;
+    udp|udp4|udp6) :;;
+    *) exit 1;;
+esac
+for file in ca.crt client1.crt client1.key; do [ -s "$pki/$file" ] || exit 1; done
+profile=$(mktemp /tmp/openvpn-client.XXXXXX)
+trap 'rm -f "$profile"' EXIT
+{
+    printf 'client\ndev tun\nproto %s\nremote %s %s\n' "$proto" "$ddns" "$port"
+    printf 'resolv-retry infinite\nnobind\npersist-key\npersist-tun\nremote-cert-tls server\nverb 3\n'
+    printf '<ca>\n'; cat "$pki/ca.crt"; printf '\n</ca>\n'
+    printf '<cert>\n'; cat "$pki/client1.crt"; printf '\n</cert>\n'
+    printf '<key>\n'; cat "$pki/client1.key"; printf '\n</key>\n'
+    [ ! -f /etc/openvpn-addon.conf ] || cat /etc/openvpn-addon.conf
+} > "$profile"
+chmod 600 "$profile"
+mv -f "$profile" /tmp/my.ovpn
