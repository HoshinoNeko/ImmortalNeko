--- a/applications/luci-app-wechatpush/root/etc/init.d/wechatpush
+++ b/applications/luci-app-wechatpush/root/etc/init.d/wechatpush
@@ -7,9 +7,18 @@
 dir="/tmp/wechatpush/"
 
 start_service() {
+    local enabled
+    enabled=$(uci -q get wechatpush.config.enable 2>/dev/null) || enabled=0
+    case "$enabled" in
+        0) return 0;;
+        1) :;;
+        *) echo "wechatpush: invalid enable flag" >&2; return 1;;
+    esac
+    if [ -x /usr/libexec/firmware-ha/service-guard.sh ]; then
+        /usr/libexec/firmware-ha/service-guard.sh wechatpush || return 0
+    fi
     procd_open_instance
-    enable_value=$(uci get wechatpush.config.enable 2>/dev/null || echo "0")
-    [ "$enable_value" -ne "0" ] && procd_set_param command /usr/share/wechatpush/wechatpush && echo "wechatpush is starting now ..."
+    procd_set_param command /usr/share/wechatpush/wechatpush
     procd_close_instance
 }
 
