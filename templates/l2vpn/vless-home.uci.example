# Merge only into /etc/config/neko-l2vpn; provision identity and certificates locally.
config transport 'main'
	option enabled '0'
	option role 'server'
	option security 'tls'
	option listen_address '0.0.0.0'
	option server_port '443'
	option server_name '<YOUR_VPN_TLS_NAME>'
	option uuid '<GENERATE_A_VLESS_UUID_LOCALLY>'
	option flow ''
	option target_address '127.0.0.1'
	option target_port '51820'
	option certificate_file '/etc/neko-l2vpn/server.crt'
	option certificate_key_file '/etc/neko-l2vpn/server.key'
